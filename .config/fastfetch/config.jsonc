{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "modules": [
        "os",
        "kernel",
        "uptime",
        "packages",
        "break",
        "cpu",
        {
            "type": "gpu",
            "format": "{1} {2} @ {12}"
        },
        "memory",
        {
            "type": "display",
            "format": "{1}x{2} @ {3} Hz in {12}\"",
            "key": "Display"
        },
        "break",
        "wm",
        "theme",
        "icons",
        "terminal",
        "shell",
        "break",
        "colors"
    ]
}

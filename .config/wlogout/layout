{
    "label": "lock",
    "action": "sleep 0.1 && loginctl lock-session",
    "keybind": "1"
}
{
    "label" : "suspend",
    "action" : "systemctl suspend",
    "keybind": "2"
}
{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "keybind": "3"
}
{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "keybind": "4"
}
{
    "label" : "logout",
    "action" : "uwsm stop",
    "keybind": "5"
}

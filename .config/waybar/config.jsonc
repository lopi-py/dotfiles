{
    "spacing": 6,
    "margin-top": 8,
    "margin-left": 8,
    "margin-right": 8,
    "modules-left": [
        "custom/powermenu",
        "group/system"
    ],
    "modules-center": [
        "hyprland/workspaces"
    ],
    "modules-right": [
        "group/status",
        "tray",
        "clock"
    ],
    "cpu": {
        "interval": 5,
        "format": "<span color='#f1ac6b'></span> {usage}%"
    },
    "memory": {
        "interval": 5,
        "format": "<span color='#89f16b'></span> {}%"
    },
    "disk": {
        "interval": 5,
        "format": "<span color='#ffc466'></span> {percentage_used}%"
    },
    "tray": {
        "icon-size": 15,
        "spacing": 6
    },
    "clock": {
        "format": "{:%a %d %b %H:%M}",
        "tooltip-format": "{calendar}"
    },
    "network": {
        "interval": 5,
        "format-wifi": "<span color='#f1ac6b'>{icon}</span> {bandwidthDownBits}",
        "format-ethernet": "",
        "format-linked": "󰤪",
        "format-disconnected": "󰤭",
        "format-disabled": "󰤭",
        "tooltip-format": "{essid} {signalStrength}%",
        "tooltip-format-ethernet": "{essid}",
        "tooltip-format-linked": "{essid}...",
        "tooltip-format-disconnected": "Disconnected",
        "tooltip-format-disabled": "Disabled",
        "format-icons": [
            "󰤯",
            "󰤟",
            "󰤢",
            "󰤥",
            "󰤨"
        ],
        "on-click": "nm-connection-editor"
    },
    "wireplumber": {
        "format": "<span color='#6b9af1'>󰕾</span> {volume}%",
        "format-muted": "󰖁 muted",
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "backlight": {
        "format": "<span color='#ebdd7a'>󰃠</span> {}%",
        "tooltip-format": "Brightness"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "interval": 5,
        "format": "<span color='#6bf1a5'>{icon}</span> {capacity}%",
        "format-warning": "{icon} {capacity}%",
        "format-critical": "{icon} {capacity}%",
        "format-charging": "󱐋 {capacity}%",
        "format-icons": [
            "󰂎",
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ]
    },
    "hyprland/workspaces": {
        "persistent-workspaces": {
            "*": 5
        }
    },
    "group/system": {
        "orientation": "inherit",
        "modules": [
            "cpu",
            "memory",
            "disk"
        ]
    },
    "group/status": {
        "orientation": "inherit",
        "modules": [
            "network",
            "wireplumber",
            "backlight",
            "battery"
        ]
    },
    "custom/powermenu": {
        "format": "",
        "tooltip": false,
        "on-click": "~/.local/bin/rofi-powermenu"
    }
}
